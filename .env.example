# Add the key for the provider you plan to use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=            # free key from build.nvidia.com (starts with nvapi-)
NVIDIA_MODEL=   # optional; any chat model from the catalog
# Other providers (optional; you can also paste a key in the web app instead)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Any other OpenAI-compatible service ("custom" provider): key here, URL/model in the app or via --base-url / --model
LLM_API_KEY=
# Parallel AI requests (lower to 1 if your provider rate-limits you)
LLM_CONCURRENCY=3
# Seconds to wait for each AI request
LLM_TIMEOUT=60
# Max output tokens per AI request (raise for reasoning/thinking models)
LLM_MAX_TOKENS=4000
